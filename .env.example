# ==============================================
# TAGS TRACKER - Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env e ajuste os valores

# URL do banco de dados SQLite (caminho dentro do container)
DATABASE_URL="file:./data/tracking.db"

# Token secreto para autenticar requisições POST/DELETE
# TROQUE ESTE VALOR por uma string longa e aleatória em produção!
API_AUTH_TOKEN="meu-token-secreto-super-seguro-2024"

# Porta em que o servidor irá escutar
PORT=3000

# Ambiente (development | production)
NODE_ENV=development

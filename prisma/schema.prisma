// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Location {
  id           String   @id @default(cuid())
  device_name  String
  latitude     Float
  longitude    Float
  battery_level Int?
  created_at   DateTime @default(now())

  @@map("locations")
  @@index([device_name])
  @@index([created_at])
}
